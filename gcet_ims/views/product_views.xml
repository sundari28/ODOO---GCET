<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_gcet_product_list" model="ir.ui.view">
        <field name="name">gcet.product.list</field>
        <field name="model">gcet.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="name"/>
                <field name="sku"/>
                <field name="category_id"/>
                <field name="uom"/>
                <field name="current_stock"/>
                <field name="minimum_stock"/>
                <field name="low_stock"/>
            </list>
        </field>
    </record>

    <record id="view_gcet_product_form" model="ir.ui.view">
        <field name="name">gcet.product.form</field>
        <field name="model">gcet.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="sku"/>
                            <field name="category_id"/>
                            <field name="uom"/>
                        </group>

                        <group>
                            <field name="initial_stock"/>
                            <field name="current_stock"/>
                            <field name="minimum_stock"/>
                            <field name="maximum_stock"/>
                        </group>
                    </group>

                    <group>
                        <field name="low_stock"/>
                        <field name="active"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gcet_product_search" model="ir.ui.view">
        <field name="name">gcet.product.search</field>
        <field name="model">gcet.product</field>
        <field name="arch" type="xml">
            <search string="Search Products">
                <field name="name"/>
                <field name="sku"/>
                <field name="category_id"/>

                <filter
                    name="low_stock"
                    string="Low Stock"
                    domain="[('low_stock', '=', True)]"
                />

                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />

                <group>
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_gcet_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">gcet.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gcet_product_search"/>
    </record>

    <record id="view_gcet_category_list" model="ir.ui.view">
        <field name="name">gcet.product.category.list</field>
        <field name="model">gcet.product.category</field>
        <field name="arch" type="xml">
            <list string="Product Categories">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gcet_category_form" model="ir.ui.view">
        <field name="name">gcet.product.category.form</field>
        <field name="model">gcet.product.category</field>
        <field name="arch" type="xml">
            <form string="Product Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gcet_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">gcet.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
