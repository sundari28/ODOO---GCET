<odoo>

    <record id="view_gcet_operation_list" model="ir.ui.view">
        <field name="name">gcet.stock.operation.list</field>
        <field name="model">gcet.stock.operation</field>
        <field name="arch" type="xml">
            <list string="Stock Operations">
                <field name="name"/>
                <field name="operation_type"/>
                <field name="date"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_gcet_operation_form" model="ir.ui.view">
        <field name="name">gcet.stock.operation.form</field>
        <field name="model">gcet.stock.operation</field>
        <field name="arch" type="xml">
            <form string="Stock Operation">

                <header>
                    <button name="action_ready"
                            string="Mark Ready"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_done"
                            string="Validate"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'ready']"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ['done', 'canceled']"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,ready,done,canceled"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Operation Details">
                            <field name="operation_type"/>
                            <field name="date"/>
                            <field name="state" readonly="1"/>
                        </group>

                        <group string="Locations">
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gcet_operation_search" model="ir.ui.view">
        <field name="name">gcet.stock.operation.search</field>
        <field name="model">gcet.stock.operation</field>
        <field name="arch" type="xml">
            <search string="Search Operations">

                <field name="name"/>
                <field name="operation_type"/>
                <field name="state"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>

                <separator/>

                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="ready"
                        string="Ready"
                        domain="[('state', '=', 'ready')]"/>

                <filter name="done"
                        string="Done"
                        domain="[('state', '=', 'done')]"/>

                <filter name="canceled"
                        string="Canceled"
                        domain="[('state', '=', 'canceled')]"/>

                <separator/>

                <filter name="receipts"
                        string="Receipts"
                        domain="[('operation_type', '=', 'receipt')]"/>

                <filter name="deliveries"
                        string="Deliveries"
                        domain="[('operation_type', '=', 'delivery')]"/>

                <filter name="internal"
                        string="Internal Transfers"
                        domain="[('operation_type', '=', 'internal')]"/>

                <filter name="adjustments"
                        string="Adjustments"
                        domain="[('operation_type', '=', 'adjustment')]"/>

            </search>
        </field>
    </record>

    <record id="action_gcet_operations" model="ir.actions.act_window">
        <field name="name">Stock Operations</field>
        <field name="res_model">gcet.stock.operation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gcet_operation_search"/>
    </record>

    <record id="action_gcet_receipts" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">gcet.stock.operation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('operation_type', '=', 'receipt')]</field>
    </record>

    <record id="action_gcet_deliveries" model="ir.actions.act_window">
        <field name="name">Delivery Orders</field>
        <field name="res_model">gcet.stock.operation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('operation_type', '=', 'delivery')]</field>
    </record>

    <record id="action_gcet_transfers" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">gcet.stock.operation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('operation_type', '=', 'internal')]</field>
    </record>

    <record id="action_gcet_adjustments" model="ir.actions.act_window">
        <field name="name">Inventory Adjustments</field>
        <field name="res_model">gcet.stock.operation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('operation_type', '=', 'adjustment')]</field>
    </record>

    <record id="view_gcet_ledger_list" model="ir.ui.view">
        <field name="name">gcet.stock.ledger.list</field>
        <field name="model">gcet.stock.ledger</field>
        <field name="arch" type="xml">
            <list string="Move History">
                <field name="date"/>
                <field name="operation_id"/>
                <field name="product_id"/>
                <field name="operation_type"/>
                <field name="quantity"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
            </list>
        </field>
    </record>

    <record id="view_gcet_ledger_search" model="ir.ui.view">
        <field name="name">gcet.stock.ledger.search</field>
        <field name="model">gcet.stock.ledger</field>
        <field name="arch" type="xml">
            <search string="Search Move History">

                <field name="operation_id"/>
                <field name="product_id"/>
                <field name="operation_type"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>

                <separator/>

                <filter name="receipts"
                        string="Receipts"
                        domain="[('operation_type', '=', 'receipt')]"/>

                <filter name="deliveries"
                        string="Deliveries"
                        domain="[('operation_type', '=', 'delivery')]"/>

                <filter name="internal"
                        string="Internal Transfers"
                        domain="[('operation_type', '=', 'internal')]"/>

                <filter name="adjustments"
                        string="Adjustments"
                        domain="[('operation_type', '=', 'adjustment')]"/>

            </search>
        </field>
    </record>

    <record id="action_gcet_ledger" model="ir.actions.act_window">
        <field name="name">Move History</field>
        <field name="res_model">gcet.stock.ledger</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_gcet_ledger_search"/>
    </record>

</odoo>
